<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Focus Ring reticle overlay -->
    <com.aiprocamera.ui.FocusRingView
        android:id="@+id/focusRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Top Pro Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="32dp"
        android:padding="8dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLASH OFF"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btnTorch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="TORCH"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- AI Real-Time Scene Detector Pill -->
        <TextView
            android:id="@+id/txtAiScene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI: Analyzing scene..."
            android:textColor="@color/gold_pro"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_mode_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnHdrBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAW HDR"
            android:textColor="@color/gold_pro"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <!-- EV Exposure Bias Slider (Pro manual control) -->
    <SeekBar
        android:id="@+id/seekExposure"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:rotation="270"
        android:max="8"
        android:progress="4"
        android:thumbTint="@color/gold_pro"
        android:progressTint="@color/gold_pro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="-60dp" />

    <!-- Zoom Quick Switch Pills (0.6x, 1x, 2x, 5x) -->
    <LinearLayout
        android:id="@+id/zoomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_glass_panel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnZoom06"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.6x"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/btnZoom1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1x"
            android:textColor="@color/gold_pro"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/btnZoom2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2x"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/btnZoom5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5x"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Processing Overlay (Visible during computational fusion) -->
    <LinearLayout
        android:id="@+id/processingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_glass_panel"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/gold_pro" />

        <TextView
            android:id="@+id/txtProcessStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Processing Frame..."
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Controls Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mode Carousel / Selector -->
        <HorizontalScrollView
            android:id="@+id/modeScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/modeAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_auto"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/modeHdr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_hdr"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/modeNight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_night"
                    android:textColor="@color/gold_pro"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/modePortrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_portrait"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/modeMacro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_macro"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/modePro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_pro"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Shutter Button Row -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="36dp"
            android:background="@drawable/bg_glass_panel"
            android:src="@drawable/ic_switch_cam"
            app:layout_constraintTop_toTopOf="@+id/btnShutter"
            app:layout_constraintBottom_toBottomOf="@+id/btnShutter"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="Switch Lens" />

        <View
            android:id="@+id/btnShutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_shutter"
            app:layout_constraintTop_toBottomOf="@+id/modeScroll"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gallery Thumbnail of last captured photo -->
        <ImageView
            android:id="@+id/imgGalleryPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/bg_glass_panel"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="@+id/btnShutter"
            app:layout_constraintBottom_toBottomOf="@+id/btnShutter"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Gallery Preview" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
